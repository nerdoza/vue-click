{
  "name": "vue-click",
  "version": "2.2.3",
  "private": false,
  "description": "Vue 3 click directive with double click, hold, repeat, press and release behaviors, and once, throttle and debounce modifiers.",
  "author": "Zachary Cardoza",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "directive",
    "click",
    "double-click",
    "hold",
    "long-press",
    "repeat",
    "touch",
    "throttle",
    "debounce"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/nerdoza/vue-click/issues"
  },
  "homepage": "https://github.com/nerdoza/vue-click#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerdoza/vue-click.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "webpack --config webpack/prod.config.js && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "dev": "webpack serve --config webpack/dev.config.js",
    "start": "npm run dev",
    "demo": "webpack --config webpack/demo.config.js",
    "test": "playwright test",
    "test:package": "npm run build && node tests/package/pack.js && tsc -p tests/package && playwright test --config tests/package/playwright.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.15.0",
    "html-webpack-plugin": "^5.6.8",
    "neostandard": "^0.14.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.46",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
